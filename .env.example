# Copy to .env (git-ignored) and fill in.
#
# Local development: run `supabase start` (see supabase/README.md), then
# `supabase status` prints the URL and anon key to use below.
#
# Hosted project: Project Settings > API in the Supabase dashboard.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# A browser key restricted to the Maps JavaScript API and this site's domain.
# Not used yet — the map isn't built. See architecture.md.
VITE_GOOGLE_MAPS_API_KEY=
