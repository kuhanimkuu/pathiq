# Copy to supabase/functions/.env (git-ignored) for local development:
#   supabase functions serve --env-file supabase/functions/.env
# For a hosted project set it as a secret:
#   supabase secrets set GOOGLE_MAPS_API_KEY=...
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to functions automatically.

# Server-side key with only the Routes API enabled. Never expose it in the browser.
GOOGLE_MAPS_API_KEY=
