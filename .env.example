# Copy to .env (git-ignored) and fill in.
#
# Local development: run `supabase start` (see supabase/README.md), then
# `supabase status` prints the URL and anon key to use below.
#
# Hosted project: Project Settings > API in the Supabase dashboard.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# A browser key restricted to the Maps JavaScript API and this site's domain.
# Loaded by src/lib/googleMaps.js for the live map at /app/map.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Cloud *vector* map ID with PathIQ's style, so the driving map
# turns heading-up and tilts natively (docs/map-styling.md, section 6).
# DEMO_MAP_ID works for a quick try, in Google's default look.
VITE_GOOGLE_MAP_ID=
